    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every response must be JSON or NDJSON, never HTML, so injected input can't render as a page.",
          "pm.test('response is JSON, not HTML', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/json/));"
        ]
      }
    }
  ],
