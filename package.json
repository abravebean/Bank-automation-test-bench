{
  "name": "bank-login-automation",
  "version": "3.0.0",
  "description": "Selenium + Playwright test dashboard for a demo bank login flow.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test:pw": "bddgen && playwright test",
    "test:pw:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:pw:headed": "playwright test --headed --project=chromium",
    "test:pw:report": "playwright show-report",
    "test:pw:install": "playwright install --with-deps",
    "test:a11y": "playwright test --project=a11y",
    "test:ci": "bddgen && playwright test --project=unit --project=api --project=a11y --project=dashboard --project=bdd-recorder --project=bank --project=bdd-bank",
    "db:up": "docker compose up -d db",
    "record": "node scripts/record.js",
    "test:unit": "playwright test --project=unit",
    "test:recorded": "playwright test --project=recorded",
    "test:dashboard": "playwright test --project=dashboard",
    "typecheck": "tsc -p .",
    "test:compliance": "bddgen && playwright test --project=unit --project=api --project=a11y --project=dashboard --project=bdd-recorder --project=bank --project=bdd-bank --project=chromium --project=bdd-login --project=site",
    "test:postman": "node scripts/run-postman.js",
    "bddgen": "bddgen",
    "test:bdd": "bddgen && playwright test --project=bdd-login --project=bdd-recorder",
    "test:bank": "bddgen && playwright test --project=bank --project=bdd-bank",
    "site:build": "esbuild lib/demo-bank/bank.js --bundle --format=iife --global-name=LedgerlineEngine --alias:crypto=./site/src/crypto-shim.js --platform=browser --target=es2020 --outfile=site/dist/ledgerline-engine.js",
    "site:preview": "npm run -s site:build && node scripts/serve-site.js"
  },
  "keywords": [
    "selenium",
    "playwright",
    "automation",
    "qa",
    "e2e",
    "page-object-model",
    "dashboard",
    "api-testing",
    "json-schema",
    "postgresql",
    "sql",
    "accessibility",
    "axe-core",
    "performance-testing",
    "data-integrity",
    "codegen",
    "test-recorder",
    "typescript",
    "compliance",
    "traceability",
    "audit-evidence",
    "bdd",
    "gherkin",
    "cucumber",
    "postman",
    "newman"
  ],
  "license": "MIT",
  "dependencies": {
    "chromedriver": "^129.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.1",
    "playwright": "^1.48.0",
    "selenium-webdriver": "^4.24.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "ajv": "^8.20.0",
    "esbuild": "^0.23.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.6.3"
  }
}
