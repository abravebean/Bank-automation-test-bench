BANK_URL=https://your-demo-bank.example.com/login
BANK_USERNAME=demo_user
BANK_PASSWORD=demo_pass
HEADLESS=true
PORT=3000
# Optional: enables run history (PostgreSQL). Matches docker-compose.yml.
DATABASE_URL=postgres://testbench:testbench@localhost:5432/testbench
# Optional: p95 latency budget for the performance tests (ms)
PERF_P95_BUDGET_MS=300
# BANK_URL / BANK_USERNAME / BANK_PASSWORD are optional: without them, tests and the
# dashboard use the built-in Ledgerline demo bank at /bank/ (demo_user / demo_pass).
